digraph G {
  graph [rankdir=LR, bgcolor="transparent", margin=0.05, nodesep=0.45, ranksep=0.85];
  node [shape=ellipse, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10];
  x [shape=circle, label="x\nεx"];
  y [shape=circle, label="y\nεy"];
  sum [label="x+y\nε₂"];
  sq [label="x²\nε₁"];
  out [label="(x+y)/x²\nε₃"];
  x -> sum [label="x/(x+y)"];
  y -> sum [label="y/(x+y)"];
  x -> sq [label="2"];
  sum -> out [label="1"];
  sq -> out [label="-1"];
}