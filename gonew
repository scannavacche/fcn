#!/bin/bash

CXX="g++"
# CXXFLAGS="-std=c++17 -O2 -Wall -Wextra -Wno-unused-parameter -Wno-unused-variable -Wno-unused-local-typedefs -Wpedantic"
CXXFLAGS="-std=c++17 -O2 -Wall -Wextra -Wno-unused-variable -Wno-unused-parameter -Wno-unused-local-typedefs -Wpedantic -Wno-unused-function -Wno-sign-compare"

LDFLAGS="-L/usr/local/lib -L/usr/local/lib/Matplot++"
LDLIBS="-Wl,--start-group -lmatplot -lnodesoup -lpng -ltiff -lz -ljpeg -lm -Wl,--end-group"

SOURCES="fcn_all.cpp fcn_lib_calc.cpp"
HEADERS="fcn_lib_calc.h menu_config.h json.hpp"
TARGET="fcn_all"

# Verifica che i sorgenti esistano
for src in $SOURCES; do
    if [[ ! -f "$src" ]]; then
        echo "Errore: file sorgente mancante: $src"
        exit 1
    fi
done

echo "Compilazione in corso..."
$CXX $CXXFLAGS $LDFLAGS $SOURCES -o $TARGET $LDLIBS

if [[ $? -eq 0 ]]; then
    echo "Compilazione completata: ./$TARGET"
    ./$TARGET
else
    echo "Compilazione fallita!"
    exit 1
fi